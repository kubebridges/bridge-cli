<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file publish profile for GitHub-release binaries.
  Supply the target RID at publish time, e.g.:
    dotnet publish Cli/src/Cli.fsproj -c Release -r win-x64   -p:PublishProfile=selfcontained
    dotnet publish Cli/src/Cli.fsproj -c Release -r linux-x64 -p:PublishProfile=selfcontained
    dotnet publish Cli/src/Cli.fsproj -c Release -r osx-arm64 -p:PublishProfile=selfcontained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContainedRelease>true</SelfContainedRelease>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
